# Copy to .env and fill in. Never commit .env.

# Neo4j (local docker-compose defaults; swap for AuraDB values in production)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=paperweave-dev

# Qdrant (local default; swap for Qdrant Cloud URL + key in production)
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
# true on Qdrant Cloud (server embeds text); false locally (fastembed on your CPU)
QDRANT_CLOUD_INFERENCE=false

# Semantic Scholar (optional; raises rate limits)
S2_API_KEY=

# Ollama (offline entity extraction)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:4b-instruct

# LLMs for the live agent (backend). Tried in order: Groq, then Gemini, then local Ollama.
# With no key set, everything runs on local Ollama. Both have free tiers:
#   Groq:   https://console.groq.com/keys      Gemini: https://aistudio.google.com/apikey
GROQ_API_KEY=
GOOGLE_API_KEY=
# true = also fall back to local Ollama when the cloud providers fail (dev only)
LLM_LOCAL_FALLBACK=false

# Backend
CORS_ORIGINS=http://localhost:3000
RATE_LIMIT_PER_HOUR=15

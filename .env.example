# Copy to .env and fill in. Never commit .env.

# Neo4j (local docker-compose defaults; swap for AuraDB values in production)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=paperweave-dev

# Qdrant (local default; swap for Qdrant Cloud URL + key in production)
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# Semantic Scholar (optional; raises rate limits)
S2_API_KEY=

# Ollama (offline entity extraction)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:4b-instruct
